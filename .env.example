# Credible Environment Configuration
# API keys are kept strictly on the backend and NEVER inside the extension.

# Backend server host & port
HOST=127.0.0.1
PORT=8000

# CORS allowed origins (include Chrome extension ID when loaded)
CORS_ORIGINS=["chrome-extension://*", "http://localhost:5173", "http://127.0.0.1:8000"]

# Google Gemini API key (user will provide for final integration testing)
GEMINI_API_KEY=your_gemini_api_key_here

# AI Model settings
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=15.0

# Security limits
MAX_PAGE_TEXT_CHARS=50000
MAX_SELECTION_TEXT_CHARS=5000

